# Renderizado por Ansible. No editar aqui: los cambios se pierden en el
# proximo despliegue. La plantilla esta en ansible/roles/dex/templates/.
services:
    dex:
        image: {{ dex_image }}
        container_name: {{ dex_container_name }}
        restart: unless-stopped
        command: ["dex", "serve", "/etc/dex/config.yaml"]
        # Sin variables de entorno con secretos: van en config.yaml, modo 0600.
        volumes:
            - {{ dex_config_dir }}/config.yaml:/etc/dex/config.yaml:ro
            - {{ dex_config_dir }}/internal-ca.pem:/etc/dex/internal-ca.pem:ro
            - {{ dex_config_dir }}/dex-cert.pem:/etc/dex/dex-cert.pem:ro
            - {{ dex_config_dir }}/dex-key.pem:/etc/dex/dex-key.pem:ro
        ports:
            # El default('0.0.0.0', true) del segundo argumento cubre tambien
            # la cadena vacia: sin el, un dex_http_bind: "" renderiza
            # ":5556:5556" y Docker publica en todas las interfaces sin que
            # nadie lo haya pedido, que es justo lo contrario de lo que
            # queria quien vacio la variable.
            - "{{ dex_http_bind | default('0.0.0.0', true) }}:{{ dex_http_port }}:5556"
            - "{{ dex_grpc_bind | default('0.0.0.0', true) }}:{{ dex_grpc_port }}:5557"
            - "127.0.0.1:{{ dex_telemetry_port }}:5558"
        healthcheck:
            test: ["CMD", "wget", "-qO-", "http://127.0.0.1:5558/healthz"]
            interval: 10s
            timeout: 3s
            retries: 5
