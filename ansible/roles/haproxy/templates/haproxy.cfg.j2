# Renderizado por Ansible. No editar aqui: los cambios se pierden en el
# proximo despliegue. La plantilla esta en ansible/roles/haproxy/templates/.
global
    log stdout format raw local0
    maxconn 4096

defaults
    log     global
    mode    http
    # "option httplog" NO va aqui: fe_grpc es mode tcp y HAProxy avisa en cada
    # arranque de que no le sirve y cae a tcplog. Funciona igual, pero un aviso
    # constante es donde se esconde el aviso que si importa. Cada frontend
    # declara el suyo.
    timeout connect 5s
    timeout client  60s
    timeout server  60s

frontend fe_https
    bind :{{ haproxy_https_port }} ssl crt /usr/local/etc/haproxy/tls/site.pem alpn h2,http/1.1
    mode http
    option httplog

    # set, no add. Con "add" queda delante la cabecera que trajera el cliente
    # y el panel lee la primera: la elegiria quien llama, y entonces cada
    # peticion anonima estrena clave en un Valkey que corre con noeviction.
    # Esta es la mitad del trato de trustForwardedFor; la otra es que los
    # puertos de los nodos no sean alcanzables por otro camino (dex_http_bind
    # y dex_dashboard_bind).
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto https

    # Se reparte por NOMBRE, no por ruta, y no es una preferencia estetica.
    # El panel registra todas sus rutas en la raiz (/callback, /clients... en
    # cmd/dex-dashboard/main.go) y su baseURL solo se usa para construir el
    # redirect_uri de OIDC: no sabe nada del prefijo por el que se le publica.
    # Servido bajo /dex-dashboard recibia "/dex-dashboard/callback", eso caia
    # en su catch-all "/", no habia sesion, arrancaba un login, dex devolvia al
    # callback y vuelta a empezar. Bucle infinito, 11 intentos por login,
    # comprobado en vivo. Quitarle el prefijo en el balanceador arregla la
    # entrada y no la salida: cada enlace de cada plantilla sigue saliendo sin
    # el. Con un nombre propio el problema no existe.
    #
    # Dex si sirve bajo la ruta de su issuer, asi que se queda de backend por
    # defecto y no necesita regla.
    use_backend be_dashboard if { req.hdr(host) -i {{ haproxy_dashboard_host }} }
    default_backend be_dex

frontend fe_grpc
    # mode tcp y sin "ssl": el 5557 de dex ya sirve TLS con el certificado de
    # la CA interna y el panel lo verifica. Terminarlo aqui y volver a emitir
    # en claro cambiaria una credencial que hoy no sale de la maquina --el
    # token gRPC-- por una que viaja por la red sin cifrar.
    bind :{{ haproxy_grpc_port }}
    mode tcp
    option tcplog
    default_backend be_grpc

# balance roundrobin y NI cookie NI stick-table en ningun backend HTTP. La
# afinidad de sesion es justo lo que el estado compartido en Valkey existe
# para hacer innecesaria, y ponerla "por si acaso" esconderia el fallo que
# delataria que el estado compartido no funciona.
backend be_dex
    mode http
    balance roundrobin
    option httpchk
    http-check send meth GET uri {{ haproxy_dex_health_path }}
{% for h in groups['dex'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ dex_http_port | default(5556) }} check
{% endfor %}

backend be_dashboard
    mode http
    balance roundrobin
    # Aviso, y no es un descuido: el /healthz del panel devuelve 200 SIEMPRE,
    # sin mirar si su conexion gRPC con dex o Valkey responden
    # (cmd/dex-dashboard/main.go). Saca de rotacion un proceso muerto, no uno
    # ciego. Es una sonda de vida, no de disponibilidad, y no puede ser otra
    # cosa mientras la entrada del TODO siga abierta.
    option httpchk
    http-check send meth GET uri {{ haproxy_dashboard_health_path }}
{% for h in groups['dex_dashboard'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ dex_dashboard_listen_port | default(5560) }} check
{% endfor %}

backend be_grpc
    mode tcp
    balance roundrobin
    option tcp-check
{% for h in groups['dex'] %}
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ dex_grpc_port | default(5557) }} check
{% endfor %}
{% if groups['mariadb'] is defined and groups['mariadb'] | length > 0 %}

frontend fe_mysql
    # mode tcp, y aqui NO es solo por no terminar el TLS. Un proxy que
    # MULTIPLEXA conexiones de cliente sobre conexiones de backend tendria que
    # rastrear el transaction_isolation que dex mete en cada conexion
    # (SERIALIZABLE, en los parametros del DSN), o dex acabaria corriendo en el
    # REPEATABLE-READ de fabrica de MariaDB sin decir una palabra. Es la misma
    # perdida silenciosa de correccion por la que se descarto Galera, entrando
    # por otra puerta. En mode tcp esto es un tubo de bytes y la sesion es de
    # punta a punta: no hay nada que rastrear.
    bind :{{ haproxy_mysql_port }}
    mode tcp
    option tcplog
    # 1h, y no los 60 s de "defaults". Un pool de conexiones no es trafico HTTP:
    # dex abre conexiones y las deja OCIOSAS entre peticiones --database/sql sin
    # connMaxLifetime--, asi que con el timeout de fabrica HAProxy corta por
    # abajo cualquier conexion del pool que pase un minuto sin usarse y dex se
    # encuentra conexiones muertas en la siguiente peticion (un error por cada
    # conexion caducada, hasta que el pool se renueva). El timeout largo tiene
    # que estar en los DOS lados de la sesion tcp: cortar solo uno deja la mitad
    # colgando.
    timeout client 1h
    default_backend be_mysql

backend be_mysql
    mode tcp
    # Un solo nodo activo a la vez: el que la sonda declara primario. No es
    # balanceo, es enrutado, y "balance first" lo deja explicito. La replica
    # figura DOWN todo el rato y a proposito.
    #
    # NI una lectura va a la replica: con replicacion por debajo, una lectura
    # enviada ahi puede no ver un codigo de autorizacion recien escrito, y eso
    # son logins que fallan sin motivo aparente y sin dejar rastro util. Dex
    # ademas usa el mismo pool para todo, asi que no hay forma de marcar "esta
    # consulta tolera retraso". No hay backend de lecturas: es una decision, no
    # una optimizacion pendiente.
    balance first
    # La otra mitad del timeout de fe_mysql: ver el comentario de alli.
    timeout server 1h
    # check port es la pieza: la salud se comprueba en el puerto del agente y el
    # trafico va al 3306. Sondeando el propio 3306 no habria forma de distinguir
    # un primario de una replica -- los dos aceptan la conexion.
    option httpchk
    http-check send meth GET uri /
    http-check expect status 200
{% for h in groups['mariadb'] %}
    # hostvars[h].mariadb_port, no mariadb_port a secas: comprobado en vivo
    # (converge de la tarea 4) que una variable sin cualificar dentro de este
    # bucle usa el valor del host que RENDERIZA la plantilla (el propio
    # balanceador), el mismo para las dos lineas, y no el de cada "h". En
    # produccion los dos nodos comparten el mismo mariadb_port (el 3306 de
    # dentro) asi que no se nota; en el converge local, con los dos nodos en
    # la misma maquina y puertos distintos por host para no chocar entre si,
    # las dos lineas salian con el puerto del primer nodo y la sonda del
    # segundo nodo comprobaba el puerto equivocado. hostvars[h] devuelve el
    # mismo resultado cuando el valor es uniforme y el correcto cuando no.
    #
    # on-marked-down shutdown-sessions: al pasar el servidor a DOWN, cierra las
    # conexiones que ya tenia abiertas. Sin esto, un primario que sigue VIVO
    # pero que ha pasado a solo lectura --lo que hace la sonda darlo por DOWN--
    # se queda con el pool de dex enganchado y recibiendo escrituras que ahora
    # fallan con "read-only", mientras el nodo promovido esta UP y sin trafico.
    # Las pruebas no lo destaparon porque todas mataban el nodo con "docker
    # stop", que rompe el TCP y hace este trabajo por casualidad; un failover de
    # verdad --orchestrator quitando y poniendo read_only-- no lo rompe.
    server {{ h }} {{ hostvars[h].ansible_host }}:{{ hostvars[h].mariadb_port }} check port {{ hostvars[h].mariadb_probe_port }} on-marked-down shutdown-sessions
{% endfor %}
{% endif %}
